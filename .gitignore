# Managed build output and the SDK-staged product bundle.
**/bin/
**/obj/

# Installed Engine release pairs and local runtime state.
.runtime/

# Local tooling caches and generated UI/test output.
node_modules/
target/
src/ui/generated/
playwright-report/
test-results/
# Art the game draws: kept out of git and synced to the NAS by scripts/art-sync.sh. Each folder's
# sources.json (how its art was made) stays in git.
content/art/**
!content/art/**/
!content/art/**/sources.json
!content/art/LICENSE.md
__pycache__/
# Raw and working asset files (the old game, generated candidates, training sets, references, screenshots): kept out
# of git and backed up to the den NAS by authoring/tools/assets-sync.sh. Their text (recipes, provenance, prompts,
# READMEs) stays in git beside them. The old Unity project, its FBX overlay and the LoRA training sets (their
# captions are regenerable) are ignored whole.
/authoring/assets/**
!/authoring/assets/**/
!/authoring/assets/**/*.txt
!/authoring/assets/**/*.json
!/authoring/assets/**/*.md
/authoring/assets/old-game/
/authoring/assets/old-game-fbx2013/
/authoring/assets/textures/lora/
