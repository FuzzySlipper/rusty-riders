<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>RustyRiders.Game.RustyRidersProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-riders</RustyEngineProductId>
    <RustyEngineProductTitle>Rusty Riders</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$(MSBuildProjectDirectory)/../ui</RustyEngineProductUiRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductContentRoot>$(MSBuildProjectDirectory)/../../content</RustyEngineProductContentRoot>
    <RustyEngineProductUiProjectionStream>rusty-riders</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>rusty.riders.hud</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineProductInputCursorMode>pointer-lock</RustyEngineProductInputCursorMode>
    <RustyEngineWatchPaths>$(MSBuildProjectDirectory);$(RustyEngineProductUiRoot);$(RustyEngineProductContentRoot)</RustyEngineWatchPaths>
  </PropertyGroup>

  <ItemGroup>
    <RustyEngineProductInputIntent Include="riders.inventory" Value="payload:riders.inventory.v1" />
    <!-- The held presentation reloads in place under rusty dev (RustyRidersProduct.ReloadHeld). -->
    <RustyEngineLiveContent Include="held/looks.json" />
    <RustyEngineLiveContent Include="held/stances.json" />
    <RustyEngineLiveContent Include="held/motion.json" />
    <RustyEngineLiveContent Include="held/arms.json" />
    <RustyEngineLiveContent Include="held/feedback.json" />
    <RustyEngineLiveContent Include="held/sway.json" />
    <RustyEngineLiveContent Include="held/rigs/generated.json" />
    <RustyEngineLiveContent Include="held/rigs/painted.json" />
    <RustyEngineLiveContent Include="held/rigs/leather.json" />
    <RustyEngineLiveContent Include="held/rigs/shared.json" />
    <!-- Looks' solved grips (held/looks.json solvedGrips); list each one here so a new solve reloads in place. -->
    <RustyEngineLiveContent Include="held/grips/maul-shared.json" />
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
